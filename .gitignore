.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
.env
.env.*
!.env.example

# uv/python tool artifacts
uv.lock
uv.cache/
.ruv/

# Pytest / type-check / linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data: user-built indexes and chroma persist across runs; do not commit
indexes/
chroma_db/
*.db
*.sqlite

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets (never commit)
